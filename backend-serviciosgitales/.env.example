# Clever Cloud MySQL (copia estos valores desde el panel del add-on)
MYSQL_ADDON_HOST=
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_USER=
MYSQL_ADDON_PASSWORD=
MYSQL_ADDON_DB=
PORT=4000
JWT_SECRET=cambia-este-secreto
CORS_ORIGIN=http://localhost:5173
# En Vercel / redes restringidas suele hacer falta TLS
MYSQL_SSL=true
MYSQL_POOL_LIMIT=5
