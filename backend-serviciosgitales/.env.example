# Clever Cloud MySQL (copia estos valores desde el panel del add-on)
MYSQL_ADDON_HOST=
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_USER=
MYSQL_ADDON_PASSWORD=
MYSQL_ADDON_DB=
PORT=4000
JWT_SECRET=cambia-este-secreto
CORS_ORIGIN=http://localhost:5173
# Activa si Clever Cloud / Vercel requiere TLS
MYSQL_SSL=false
MYSQL_POOL_LIMIT=5
